<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <defaultDocument enabled="true"><files><clear/><add value="default.asp"/></files></defaultDocument>
    <security><requestFiltering>
      <hiddenSegments><add segment="includes"/><add segment="SongFiles"/><add segment="tools"/></hiddenSegments>
      <fileExtensions><add fileExtension=".sql" allowed="false"/></fileExtensions>
    </requestFiltering></security>
    <directoryBrowse enabled="false"/>
  </system.webServer>
</configuration>
