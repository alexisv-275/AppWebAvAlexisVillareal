<%@ Page Title="Canciones" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="Song.aspx.cs" Inherits="WebAppPoliMusicV3.Song" %>
<asp:Content ContentPlaceHolderID="MainContent" runat="server"><section class="catalog-head"><div><p class="eyebrow">TU BIBLIOTECA</p><h1>Canciones para<br/>cada momento.</h1><p>Escucha, pausa y vuelve a encontrar tu ritmo.</p></div><div class="mini-record" aria-hidden="true">♫</div></section>
<section class="library"><div class="library-title"><div><h2>Explora el catálogo</h2><p><asp:Literal ID="songCount" runat="server"/> canciones en tu biblioteca</p></div><label class="search-label" for="songSearch">Buscar canción<input type="search" id="songSearch" placeholder="Escribe el nombre…"/></label></div>
<asp:Label ID="lblMessage" runat="server" CssClass="message" role="status"/>
<div class="table-scroll"><asp:GridView ID="gvSongs" runat="server" AutoGenerateColumns="false" CssClass="song-table" GridLines="None" UseAccessibleHeader="true" EmptyDataText="Todavía no hay canciones en la biblioteca." OnRowDataBound="Songs_RowDataBound">
<Columns><asp:BoundField DataField="ID_SONG" HeaderText="#"/><asp:TemplateField HeaderText="Canción"><ItemTemplate><span class="song-mark" aria-hidden="true">♫</span><strong><%#: Eval("SONG_NAME") %></strong></ItemTemplate></asp:TemplateField><asp:BoundField DataField="PLAYS" HeaderText="Reproducciones"/><asp:TemplateField HeaderText="Escuchar"><ItemTemplate><asp:Literal ID="player" runat="server"/></ItemTemplate></asp:TemplateField></Columns></asp:GridView></div>
<p id="searchEmpty" hidden>No hay canciones con ese nombre.</p><p class="hint">Puedes reproducir las canciones que tienen un archivo de audio disponible.</p></section></asp:Content>
