<?xml version="1.0" encoding="utf-8"?>
<configuration>
 <appSettings>
  <add key="maxSongLength" value="52428800"/><add key="albumImagePath" value="~/AlbumImages/"/>
  <add key="artistImagePath" value="~/ArtistImages/"/><add key="userPhotoPath" value="~/UserImages/"/>
  <add key="songFolderPath" value="~/SongFiles/"/><add key="playlistFolderPath" value="~/PlaylistImages/"/>
  <add key="ValidationSettings:UnobtrusiveValidationMode" value="None"/>
 </appSettings>
 <connectionStrings><add name="BDD_PoliMusicConnectionString" connectionString="Data Source=.\SQLSERVER2025;Initial Catalog=BDD_PoliMusic;Integrated Security=SSPI" providerName="System.Data.SqlClient"/></connectionStrings>
 <system.web>
  <compilation debug="true" targetFramework="4.8"/>
  <httpRuntime targetFramework="4.8" maxRequestLength="51200"/>
  <authentication mode="Forms"><forms loginUrl="~/Login" defaultUrl="~/Default" timeout="20" cookieless="UseCookies"/></authentication>
  <authorization><deny users="?"/></authorization>
  <sessionState timeout="20"/><httpCookies httpOnlyCookies="true" sameSite="Lax"/>
  <customErrors mode="RemoteOnly"/>
 </system.web>
 <location path="Login"><system.web><authorization><allow users="*"/></authorization></system.web></location>
 <location path="Login.aspx"><system.web><authorization><allow users="*"/></authorization></system.web></location>
 <location path="SignUp"><system.web><authorization><allow users="*"/></authorization></system.web></location>
 <location path="SignUp.aspx"><system.web><authorization><allow users="*"/></authorization></system.web></location>
 <location path="Content"><system.web><authorization><allow users="*"/></authorization></system.web></location>
 <location path="Scripts"><system.web><authorization><allow users="*"/></authorization></system.web></location>
 <system.webServer><modules runAllManagedModulesForAllRequests="true"/>
  <security><requestFiltering><requestLimits maxAllowedContentLength="52428800"/></requestFiltering></security>
 </system.webServer>
</configuration>
